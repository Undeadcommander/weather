{
  "name": "skylens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build.mjs --pages",
    "start": "node scripts/serve.mjs",
    "dev": "npm run build && npm start",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.js",
    "test:live": "node scripts/check-live.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "esbuild": "0.28.2"
  }
}
